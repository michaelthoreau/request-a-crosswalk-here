# Public URL used in QR codes, emails, and share text.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs map lookups. Generate with: openssl rand -base64 32
APP_SECRET=

# Local SQLite file in dev; Turso in production (libsql://<db>-<org>.turso.io).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Leave empty in dev to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Request a Crosswalk Here <hello@requestacrosswalkhere.org>"
